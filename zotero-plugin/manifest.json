{
  "manifest_version": 2,
  "name": "AI 论文阅读助手",
  "version": "1.1.0",
  "description": "Zotero PDF 阅读器内的英文→中文学术翻译，支持含公式的截图翻译（本地 vLLM + HY-MT1.5 + HunyuanOCR-1.5）。",
  "author": "maipeng",
  "homepage_url": "https://github.com/maipeng/ai-paper-reader",
  "permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "48": "chrome/content/icons/bard.png",
    "96": "chrome/content/icons/bard.png"
  },
  "applications": {
    "zotero": {
      "id": "ai-paper-reader@maipeng.com",
      "update_url": "https://github.com/maipeng/ai-paper-reader/releases/download/release/update.json",
      "strict_min_version": "7.9.9",
      "strict_max_version": "10.*"
    }
  },
  "browser_specific_settings": {
    "zotero": {
      "id": "ai-paper-reader@maipeng.com",
      "update_url": "https://github.com/maipeng/ai-paper-reader/releases/download/release/update.json",
      "strict_min_version": "7.9.9",
      "strict_max_version": "10.*"
    }
  }
}
